# Copy this file to .env in the project root. Restart the backend after editing.
# Variables already set by the process host take precedence over .env.
COGNITION_DB=data/platform.db
COGNITION_TIMEOUT=120
GEMINI_MODEL=gemini-3.8-flash
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# One virtual environment (.venv) runs every harness. Leave a value blank to run that harness
# in-process. Set an environment directory or interpreter path to run it in a child process
# (cleaner cancellation). Antigravity defaults to a child process of the same .venv.
COGNITION_DEEPAGENTS_PYTHON=
COGNITION_ADK_PYTHON=
COGNITION_ANTIGRAVITY_PYTHON=.venv

# Set to true to start the world clock for every plant at launch. Default: off.
COGNITION_WORLD_AUTOSTART=false
# Strict mode freezes sampling during an investigation and allows no revision drift.
COGNITION_STRICT_MODE=false
# Live mode: how many plant revisions a proposal may lag behind when the Gateway validates it.
COGNITION_LIVE_DRIFT=300
# Main-harness tool calls allowed per incident. High on purpose; not a run budget.
COGNITION_TOOL_CAP=200
# Core agents (Google ADK). Off by default: turning them on makes live model calls.
COGNITION_CORE_AGENTS=false
# Optional model for the core agents; defaults to GEMINI_MODEL.
COGNITION_CORE_MODEL=
# Wall-clock ceiling for one core run, in seconds. 0 turns the ceiling off.
COGNITION_CORE_RUN_SECONDS=600
# Kill switch, in seconds. This long after a simulation run starts, every agent and the main harness is
# stopped (runs end "interrupted"), robots return to the dock and the UI says so. Reset the plant or start
# the simulation again to begin a new run. 0 turns it off.
COGNITION_KILL_AFTER_SECONDS=0
# Network. `cognition serve` listens on COGNITION_HOST:COGNITION_PORT (default 127.0.0.1:8000). The Docker image
# sets 0.0.0.0:8000 inside the container; FABRIX_PORT (compose only) picks the port published on the server.
# The API has no authentication: expose it only behind an authenticating reverse proxy or a private network.
COGNITION_HOST=
COGNITION_PORT=
FABRIX_PORT=
